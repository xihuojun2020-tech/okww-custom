msgstr "フレームのパス（1行に1つ）"

msgid "Refresh to list visible windows"
msgstr "更新して表示中のウィンドウを一覧表示"

msgid "Refresh windows"
msgstr "ウィンドウを更新"

msgid "Select a window or enter HWND below"
msgstr "ウィンドウを選択するか、下に HWND を入力"

msgid "Capabilities: {capabilities}"
msgstr "対応機能：{capabilities}"

msgid "Device options must be a JSON object with a type"
msgstr "デバイス設定は type を含む JSON オブジェクトである必要があります"

msgid "Unknown device type: {kind}"
msgstr "不明なデバイス種類：{kind}"

msgid "{field} must be an integer"
msgstr "{field}には整数を入力してください"

msgid "{field} cannot be negative"
msgstr "{field}には負の値を指定できません"

msgid "Window enumeration failed: {error}"
msgstr "ウィンドウの列挙に失敗しました：{error}"
