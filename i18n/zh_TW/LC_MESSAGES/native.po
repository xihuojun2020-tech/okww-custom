msgid " 正在重新加载配置进程…"
msgstr " 正在重新載入設定程序…"

msgid " 磁盘已提交，请重启管理窗口以重新加载账号；旧账号编辑已停用。"
msgstr " 磁碟已提交，請重新啟動管理視窗以載入帳號；舊帳號編輯已停用。"

msgid " 配置进程已重新加载。"
msgstr " 設定程序已重新載入。"

msgid "任务注册已更新到磁盘，配置进程未应用；运行中保留旧注册表。"
msgstr " 任務註冊已寫入磁碟，但設定程序尚未套用；執行中保留舊註冊表。"

msgid "修改提示已复制，可粘贴到聊天工具并补充需求。"
msgstr " 修改提示已複製，可貼到聊天工具並補充需求。"

msgid "删除整个脚本包的任务注册？配置和历史源码保留。"
msgstr " 刪除整個腳本包的任務註冊？設定與歷史原始碼會保留。"

msgid "删除此角色自定义代码并恢复内置模式？"
msgstr " 刪除此角色的自訂程式碼並還原內建模式？"

msgid "安全模式：请建立首账号、导入配置包或查看完整性检查。\n"
msgstr "安全模式：請建立第一個帳號、匯入設定包或查看完整性檢查。\n"

msgid "导入会执行可信 Python 验证代码。相同脚本包标识会整组更新；原配置和历史源码保留。"
msgstr "匯入會執行可信的 Python 驗證程式碼。相同腳本包識別碼會整組更新；原設定與歷史原始碼保留。"

msgid "导入包成员不能单独删除，请使用删除脚本包。"
msgstr "匯入包成員不能單獨刪除，請使用「刪除腳本包」。"

msgid "导入包成员为只读；通过整组重导入更新代码和素材。"
msgstr "匯入包成員為唯讀；請整組重新匯入以更新程式碼與素材。"

msgid "当前为源码工作目录，不能在管理窗口替换游戏包；请使用已安装且带文件清单的游戏包。"
msgstr "目前為原始碼工作目錄，不能在管理視窗替換遊戲包；請使用已安裝且附檔案清單的遊戲包。"

msgid "操作失败，输出迁移未提交："
msgstr "操作失敗，輸出遷移未提交："

msgid "放弃当前未保存的修改？"
msgstr "放棄目前未儲存的修改？"

msgid "放弃当前未保存的角色修改？"
msgstr "放棄目前未儲存的角色修改？"

msgid "新任务：保存时生成稳定ID"
msgstr "新任務：儲存時產生穩定 ID"

msgid "旧包迁移任务：确认导出类、稳定 key 与设备能力"
msgstr "舊包遷移任務：確認匯出類別、穩定 key 與裝置能力"

msgid "未选择执行进程；展示已保存记录。"
msgstr "未選擇執行程序；顯示已儲存記錄。"

msgid "正在编辑自定义草稿，保存后才启用。"
msgstr "正在編輯自訂草稿，儲存後才啟用。"

msgid "此动作需要执行器连接游戏设备。"
msgstr "此動作需要執行器連接遊戲裝置。"

msgid "此页迁移输出资料，并保留原文件。账号、配置、用户脚本和数据根不迁移。迁移前停止本窗口配置进程；其他所有者仍占用数据时会明确失败。"
msgstr "此頁遷移輸出資料並保留原檔。帳號、設定、使用者腳本與資料根不遷移。遷移前停止本視窗的設定程序；其他擁有者仍占用資料時會明確失敗。"

msgid "每次导出一个完整脚本包，或一组独立任务。"
msgstr "每次匯出一個完整腳本包或一組獨立任務。"

msgid "源码已读取。修改类名仍保留这个稳定任务ID与配置。"
msgstr "原始碼已讀取。修改類別名稱仍保留此穩定任務 ID 與設定。"

msgid "独立管理窗口：账号设置、序列与已有完成证据；读取特征码和设备动作由已启动的任务进程执行。"
msgstr "獨立管理視窗：帳號設定、序列與既有完成證據；特徵碼讀取和裝置動作由已啟動的任務程序執行。"

msgid ""
"用户任务使用 NativeBaseTask / "
"NativeTriggerTask。保存前独立验证代码；此处编辑的是可信可执行代码。保存只更新配置进程，实际运行进程需明确重载或重新启动。"
msgstr ""
"使用者任務使用 NativeBaseTask / "
"NativeTriggerTask。儲存前獨立驗證可信可執行程式碼。儲存只更新設定程序；實際執行程序需明確重新載入或啟動。"

msgid "由已启动的任务进程连续读取特征码，再确认绑定账号"
msgstr "由已啟動的任務程序連續讀取特徵碼，再確認綁定帳號"

msgid "脚本包注册与素材已更新，配置进程已应用；实际 worker 需明确重载。"
msgstr "腳本包註冊與素材已更新，設定程序已套用；實際 worker 需明確重新載入。"

msgid "角色代码已保存，配置进程未应用；运行进程保留旧代码。"
msgstr "角色程式碼已儲存，但設定程序尚未套用；執行程序保留舊程式碼。"

msgid "角色修改已保存，配置进程已应用。实际运行进程需明确重载或重启任务。"
msgstr "角色修改已儲存，設定程序已套用。實際執行程序需明確重新載入或重啟任務。"

msgid "角色源码已读取。自定义代码须保留当前类名。"
msgstr "角色原始碼已讀取。自訂程式碼須保留目前類別名稱。"

msgid "请先选择角色并切换到自定义代码。"
msgstr "請先選擇角色並切換至自訂程式碼。"

msgid "请选择一个脚本包，或一个以上独立任务。"
msgstr "請選擇一個腳本包或一個以上獨立任務。"

msgid "账号配置包已导出。"
msgstr "帳號設定包已匯出。"

msgid "账号配置已验证，可在任务窗口执行。"
msgstr "帳號設定已驗證，可在任務視窗執行。"

msgid "输出目录已提交，原文件保留；数据根未迁移。配置进程将重新加载目录配置。"
msgstr "輸出目錄已提交，原檔保留，資料根未遷移。設定程序將重新載入目錄設定。"

msgid "输出目录已提交，收尾失败，请重新加载管理窗口："
msgstr "輸出目錄已提交，但收尾失敗，請重新載入管理視窗："

msgid "选择内置或自定义角色代码。保存前独立验证；运行中的共享会话需要明确重载，单次任务重启后应用。"
msgstr "選擇內建或自訂角色程式碼。儲存前獨立驗證；執行中的共用工作階段需明確重新載入，單次任務重啟後套用。"

msgid "选择数据根所在本机磁盘上的空输出目录，先预览再迁移。"
msgstr "選擇資料根所在本機磁碟上的空輸出目錄，先預覽再遷移。"

msgid ""
"选择角色和自定义模式，编辑或粘贴完整 Python 文件。改动行会高亮。\n"
"保存前独立验证代码；失败会保留草稿。运行中的共享会话需在启动器明确重载，单次任务需重新启动。恢复内置会删除此角色的自定义源码。"
msgstr ""
"選擇角色與自訂模式，編輯或貼上完整 Python 檔案。修改行會反白。\n"
"儲存前獨立驗證程式碼；失敗時保留草稿。共用工作階段需明確重新載入，單次任務需重新啟動。還原內建模式會刪除此角色的自訂原始碼。"

msgid "配置进程不可用，未提交代码。"
msgstr "設定程序無法使用，程式碼未提交。"

msgid "配置进程不可用，未提交角色修改。"
msgstr "設定程序無法使用，角色修改未提交。"

msgid "验证与保存完成；配置进程已应用。实际worker需明确重载或重新启动。"
msgstr "驗證與儲存完成，設定程序已套用。實際 worker 需明確重新載入或啟動。"

msgid "维护失败："
msgstr "維護失敗："

msgid "输出目录已提交。"
msgstr "輸出目錄已提交。"

msgid "配置维护已提交。"
msgstr "設定維護已提交。"

msgid "配置备份已创建。"
msgstr "設定備份已建立。"

msgid "配置进程启动失败。"
msgstr "設定程序啟動失敗。"

msgid " 配置进程未恢复："
msgstr " 設定程序未恢復："

msgid "已有操作正在进行，或账号运行时需要重新启动；暂不能维护配置"
msgstr "已有操作正在進行，或帳號執行環境需要重新啟動；暫不能維護設定"

msgid "建立账号 {label} 的可信总配置？请确认手机号、昵称及所选序列。"
msgstr "建立帳號 {label} 的可信總設定？請確認手機號碼、暱稱及所選序列。"

msgid ""
"将替换当前全部账号配置：{accounts} 个账号，{sequences} 个序列，{records} 条完成记录。\n"
"导入前将保存事务备份。"
msgstr ""
"將取代目前全部帳號設定：{accounts} 個帳號，{sequences} 個序列，{records} 筆完成記錄。\n"
"匯入前將儲存交易備份。"

msgid ""
"\n"
"配置包已被外部修改；确认将明确接受这些修改。"
msgstr ""
"\n"
"設定包已被外部修改；確認將明確接受這些修改。"

msgid "目录尚未创建："
msgstr "目錄尚未建立："

msgid "无法打开目录："
msgstr "無法開啟目錄："

msgid "输出迁移预览：{files}个文件，{size:.2f} MiB。保留原文件；账号、配置和用户脚本留在数据根。"
msgstr "輸出遷移預覽：{files} 個檔案，{size:.2f} MiB。保留原檔案；帳號、設定和使用者腳本留在資料根目錄。"

msgid ""
"将输出复制并校验到：{destination}\n"
"保留原文件，更新输出目录配置，随后重新加载配置进程。"
msgstr ""
"將輸出複製並驗證至：{destination}\n"
"保留原檔案，更新輸出目錄設定，隨後重新載入設定程序。"

msgid "已读取{count}个用户任务；已保存版本 {saved}，配置进程版本 {applied}；运行进程需单独重载。"
msgstr "已讀取 {count} 個使用者任務；已儲存版本 {saved}，設定程序版本 {applied}；執行程序需另外重新載入。"

